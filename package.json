{
  "name": "anonconnect",
  "version": "1.0.0",
  "description": "Anonymous chat and voice/video calling platform powered by Socket.io and WebRTC.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:picker": "esbuild src/picker-bundle.jsx --bundle --format=iife --outfile=public/js/emoji-gif-bundle.js --minify && mv -f public/js/emoji-gif-bundle.css public/css/emoji-gif-bundle.css"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "emoji-picker-react": "^5.1.4",
    "esbuild": "^0.28.2",
    "gif-picker-react": "^2.0.0",
    "nodemon": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
