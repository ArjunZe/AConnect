PORT=9876
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*
DEFAULT_ROOM_PASSWORD=turtle

# Northflank Persistent Volume Mount Path (e.g., /app/data or /app/public/uploads)
# Stores chat history, room states, encrypted notes, and gallery manifest
DATA_DIR=/app/data

# Directory for high-res images and thumbnails (defaults to $DATA_DIR/uploads)
UPLOADS_DIR=/app/data/uploads
